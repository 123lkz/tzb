{
  "compilerOptions": {
    "module": "commonjs",
    // 编译生成的模块系统代码
    "target": "es2017",
    // 指定ecmascript的目标版本
    "moduleResolution": "node",
    "noImplicitAny": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "resolveJsonModule": true,
    // 禁止隐式any类型
    "outDir": "./dist",
    "sourceMap": false,
    "allowJs": false,
    // 是否允许出现js
    "newLine": "LF",
    "paths": {
      "~": ["./src"]
    },
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "declarationMap": false
  },
  "ts-node": {
    "transpileOnly": true,
    "files": true
  },
  "include": ["src/**/*", "tests/**/*"],
  "exclude": ["node_modules", "dist"]
}
